# Application Environment Mode: DEMO, TEST, or LIVE
NODE_ENV=development
APP_MODE=DEMO
PORT=3001

# Google Gemini AI API Credentials
GEMINI_API_KEY=

# Persistent SQL Database Connection (defaults to local SQLite database)
DATABASE_URL=sqlite://./server/engagement_agent.db

# X / Twitter OAuth 2.0 Credentials
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3001/api/auth/x/callback
X_BEARER_TOKEN=

# LinkedIn OAuth Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

# Instagram / Meta Graph API Credentials
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/auth/meta/callback
META_ACCESS_TOKEN=

# Hindsight Memory Layer Credentials
HINDSIGHT_API_KEY=hsk_a86e862cbe94486436acdb0b8a936670_ff14afe352eaeade
